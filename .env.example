# OpenAI API Key (or local token, e.g. 123456 or not-needed)
OPENAI_API_KEY=123456

# Optional: Base URL for local or custom OpenAI-compatible server (e.g. LM Studio, Ollama, vLLM)
# Leave commented or empty to use official OpenAI cloud endpoint
OPENAI_BASE_URL=http://127.0.0.1:8317/v1

# Model Name (Default: gpt-4o or your local model identifier)
MODEL_NAME=gpt-4o

# Keystroke Engine Timings
FOCUS_DELAY_SECONDS=2
MIN_TYPE_DELAY=0.003
MAX_TYPE_DELAY=0.010

# Emergency Stop Trigger
EMERGENCY_STOP_KEY=<esc>
